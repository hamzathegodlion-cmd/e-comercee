# Copy to .env.local and fill in ONLY after Ethio telecom grants you
# merchant/integration credentials. Never commit real credentials.
# Without these, the app runs fully simulated (default, safe).

# Base URL of the telebirr integration gateway issued to you
VITE_TELEBIRR_API_URL=

# Bearer key/token issued to you by Ethio telecom
VITE_TELEBIRR_API_KEY=
