{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "node_modules/better-sqlite3/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|src/assets/|assets/|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
